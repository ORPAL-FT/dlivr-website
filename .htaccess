# =====================================================================
# dlivr.eu — Auslieferung (Apache / LiteSpeed, wie bei Hostinger)
#
# Diese Datei sperrt Arbeitsdateien. Sie aendert nichts an der Seite selbst:
# keine Umleitungen; einzige Kopfzeile seit 05.10.2026: HTML wird bei jedem
# Aufruf nachgefragt (ganz unten). Wer die Seite
# woanders betreibt, kann sie ersatzlos weglassen — dann liegen die
# Arbeitsdateien allerdings offen.
#
# Angelegt am 26.09.2026, nachdem auffiel, dass ueber dlivr.eu die Generatoren
# unter werkzeug/ und die README mit HTTP 200 zu lesen waren. Grund ist die
# Git-Anbindung von hPanel: Sie legt den ganzen Zweig in public_html, nicht
# eine Auswahl. mi-tool.tech hat dieselbe Sperre seit dem 11.09.2026.
# =====================================================================

# --- Verzeichnisse nicht auflisten -----------------------------------
Options -Indexes

# --- Arbeitsdateien nicht ausliefern ---------------------------------
# Oeffentlich sind: die .html-Seiten, assets/, css/, robots.txt, sitemap.xml.
# Alles andere im Zweig ist Arbeitsmaterial.
<FilesMatch "\.(md|py|sh|toml|yml|yaml)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/werkzeug/
RedirectMatch 404 ^/pruefungen/
RedirectMatch 404 ^/live-abzug/

# --- Die Kopie des Repositorys ---------------------------------------
# Ein Git-Auscheck legt .git/ mit ab: vollstaendige Historie, jede fruehere
# Fassung, die Fernadresse. Deckt auch .gitignore und .gitattributes ab.
# .well-known bleibt bewusst offen, die Zertifikatsstelle braucht es.
RedirectMatch 404 ^/\.git

<Files ".DS_Store">
  Require all denied
</Files>
RedirectMatch 404 (^|/)\.DS_Store$

# --- Ausgetragene Bilder mit Kundenbezug -----------------------------
# assets/mi-tool-suche.png zeigte vom 17.09. bis 05.10.2026 im Dateipfad den
# Ordnernamen eines Kunden. Die Datei ist aus dem Zweig entfernt; weil die
# Git-Anbindung auf dlivr.eu Ausgetragenes schon liegen ließ (26.09.2026),
# sperrt diese Zeile die Adresse zusätzlich — unabhängig davon, ob die Datei
# auf dem Webspace noch liegt.
RedirectMatch 404 ^/assets/mi-tool-suche\.png$

# --- HTML bei jedem Aufruf nachfragen ---------------------------------
# Seit 05.10.2026, auf Franks Wunsch. Ohne diese Zeile hielten Browser eine
# Seite nach eigenem Ermessen vor: Am 05.10. zeigte ein Fenster Minuten nach
# dem Ausrollen noch die alte Startseite, obwohl der Server die neue
# lieferte. Gleiche Regel wie auf mi-tool.tech. Bilder, CSS und Skripte
# bleiben unberührt; sie tragen ihre Fassung im Namen oder in ?v=.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

